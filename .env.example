# Copie para .env e preencha. O .env real nunca vai para o git.

# --- Supabase: identificação do projeto ---------------------------------
SUPABASE_PROJECT_REF=
SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co

# --- Chaves da API (Project Settings > API Keys) ------------------------
SUPABASE_ANON_KEY=
# Só para scripts de manutenção. NUNCA com prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Conexão direta ao Postgres (Connect > Session pooler) --------------
# Necessária para migrações e geração de tipos.
# postgresql://postgres.REF:SENHA@aws-0-REGIAO.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=

# --- Expostas ao browser pelo Next.js -----------------------------------
# Repetem os valores acima. Apenas URL e chave pública.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Opcionais -----------------------------------------------------------
# Habilita as respostas em linguagem natural do assistente.
# Sem ela, o motor local responde as perguntas do dia a dia.
ANTHROPIC_API_KEY=

# Personal Access Token do Supabase (Account > Access Tokens), para MCP.
SUPABASE_ACCESS_TOKEN=
